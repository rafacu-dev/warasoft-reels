# Claves de ElevenLabs para la voz. Este archivo se copia como .env (chmod 600) al montar la cuenta.
# Pega aquí tus valores con un editor de texto. Nunca los pegues en el chat ni los subas a git.
ELEVENLABS_API_KEY=
# Opcional: más cuentas, que se usan en orden cuando una se queda sin saldo.
# ELEVENLABS_API_KEY_2=
# ELEVENLABS_API_KEY_3=
# La voz: elige una con `node scripts/voz-elevenlabs.mjs --voces` (p. ej. la prediseñada "Bill").
ELEVENLABS_VOICE_ID=
